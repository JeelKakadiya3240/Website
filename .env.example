# Contact form (Resend) — add these in Vercel:
#   Project → Settings → Environment Variables
# For local testing with `vercel dev`, copy this file to `.env` (git-ignored).

# Required — your Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — where form messages are delivered (default: jkakadi1@asu.edu)
CONTACT_TO=jkakadi1@asu.edu

# Optional — the "From" address. Must be on a domain you've verified in Resend
# (e.g. contact@jeelkakadiya.com). If unset, defaults to onboarding@resend.dev,
# which only delivers to your own Resend account email (fine for a first test).
CONTACT_FROM=Portfolio Contact <contact@jeelkakadiya.com>
