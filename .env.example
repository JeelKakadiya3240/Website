# Contact form (Resend) — add these in Vercel:
#   Project → Settings → Environment Variables
# For local testing with `vercel dev`, copy this file to `.env` (git-ignored).

# Required — your Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — where form messages are delivered (default: jeelkakadiya11@gmail.com)
CONTACT_TO=jeelkakadiya11@gmail.com

# Optional — the "From" address, on your verified domain
# (default: Portfolio Contact <contact@jeelkakadiya.com>)
CONTACT_FROM=Portfolio Contact <contact@jeelkakadiya.com>
